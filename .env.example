# ─────────────────────────────────────────────────────────────────────────────
# Planify — environment variables (copy to `.env` locally, add in Vercel)
# NEVER commit `.env` with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase Auth (production — required on Vercel) ---
# Vite reads VITE_* ; NEXT_PUBLIC_* also works (see vite.config envPrefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server only — Vercel env, NEVER expose to client bundles
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site URL for email confirm + OAuth redirects
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Local: http://localhost:5173

# --- Optional Resend (welcome + security emails via /api/send-email) ---
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# --- Legacy Express API (optional; Supabase takes priority when configured) ---
VITE_USE_REAL_API=false
VITE_API_BASE_URL=
VITE_APP_NAME=Planify

# --- Express server (local dev only, not on Vercel static) ---
SERVER_PORT=8787
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=./server/data/planify.db

# Phone OTP: configure Twilio/MessageBird in Supabase Dashboard → Auth → Phone
# No client env vars for SMS secrets.
