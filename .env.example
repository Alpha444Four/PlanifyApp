# ─────────────────────────────────────────────────────────────────────────────
# Planify — environment variables (copy to `.env`)
# NEVER commit `.env` with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# --- Frontend (Vite) ---
VITE_APP_NAME=Planify

# Vercel (static frontend): use demo mode unless you host the API elsewhere
# VITE_USE_REAL_API=false
# VITE_API_BASE_URL=

# Local dev with Express API on port 8787:
VITE_USE_REAL_API=true
# Leave empty in dev — Vite proxies `/api` -> http://localhost:8787
VITE_API_BASE_URL=

# Production with API on another host (Railway, Render, Fly.io, etc.):
# VITE_USE_REAL_API=true
# VITE_API_BASE_URL=https://your-api.example.com

# --- Backend API (server/) ---
SERVER_PORT=8787
JWT_SECRET=replace-with-openssl-rand-hex-32-chars-minimum
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
DATABASE_PATH=./server/data/planify.db
DEV_LOG_EMAILS=true
NODE_ENV=development

# --- Production email (server-side, TODO) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@planify.app

# --- Future AI (server-side only) ---
# OPENAI_API_KEY=
